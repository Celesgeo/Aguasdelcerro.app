# Copiá este archivo a `.env.local` y completá valores reales.
# `.env.local` NO se sube a GitHub.

# Obligatorio para el panel /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Mínimo 32 caracteres aleatorios
ADMIN_SESSION_SECRET=

# Seguridad (producción)
# - ADMIN_PASSWORD: 16+ caracteres aleatorios
# - ADMIN_SESSION_SECRET: 32+ caracteres aleatorios (nunca commitear)
# - Las variables sensibles van SOLO en Railway, nunca en public/ ni en GitHub
# - ENABLE_CAREERS_STATUS=true solo para diagnóstico interno de email (opcional)
# ENABLE_CAREERS_STATUS=

# URL pública canónica — usada en sitemap, canonical, Open Graph y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.aguasdelcerro.com.ar

# Google Search Console — código de verificación HTML (meta tag)
# Obtenelo en: Search Console → Configuración → Verificación de propiedad → Etiqueta HTML
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=abc123...

# Google Analytics 4 — ID de medición (empieza con G-)
# Analytics → Administrar → Flujo de datos web → ID de medición
# En Railway alcanza con UNA de estas dos (mismo valor G-...):
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Base de datos (Railway → servicio Postgres). En Railway se carga como referencia:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Mercado Pago · Checkout Pro (Tus integraciones → Aguas del Cerro Web)
# Access Token de producción (empieza con APP_USR-). Solo en Railway, nunca en GitHub.
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones → Webhooks). Recomendado.
# MP_WEBHOOK_SECRET=

# Correo que recibe la copia de cada reserva pagada (opcional;
# por defecto usa CAREERS_NOTIFY_EMAIL).
# RESERVATIONS_NOTIFY_EMAIL=

# Postulaciones laborales — envío por email
#
# === OPCIÓN A (recomendada) — Resend: incluye CV adjunto ===
# 1. https://resend.com → API Keys
# 2. Verificá el dominio aguasdelcerro.com.ar (DNS) o usá onboarding@resend.dev para pruebas
# RESEND_API_KEY=
# RESEND_FROM=Aguas del Cerro <contacto@aguasdelcerro.net>
# CAREERS_NOTIFY_EMAIL=tu-email@gmail.com
#
# === OPCIÓN B — Web3Forms: gratis, SIN adjuntar CV (plan free) ===
# Recibís los datos del postulante; contactalo para pedirle el CV por email/WhatsApp.
# 1. https://web3forms.com → access key con el email donde querés recibir avisos
# WEB3FORMS_ACCESS_KEY=
#
# === OPCIÓN C — Gmail SMTP (funciona en local; Railway puede bloquearlo) ===
# Contraseña de aplicación: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=contacto@aguasdelcerro.net
SMTP_PASS=
# Remitente visible (opcional)
# SMTP_FROM=contacto@aguasdelcerro.net
# Destino de CVs (opcional; por defecto usa el email del sitio)
# CAREERS_NOTIFY_EMAIL=contacto@aguasdelcerro.net

# Instagram — feed en la home (opcional)
# Token de larga duración desde Meta for Developers → Instagram API
# https://developers.facebook.com/docs/instagram-platform
# INSTAGRAM_ACCESS_TOKEN=

# NODE_ENV=production
